<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Enclave.Sdk.Api" Version="1.0.5" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="NUnit" Version="4.4.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.1.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.11.2" />
    <!--
      WireMock.Net 1.19.0, the version enclave.sdk.api's tests use, depends on Scriban.Signed 5.5.0,
      which NuGet audit reports as vulnerable (NU1903, NU1904), so restore fails with warnings as
      errors. 2.18.0 depends on Scriban.Signed 7.2.5.
    -->
    <PackageVersion Include="WireMock.Net" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>
</Project>
