<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This is a public repository, so it restores from nuget.org alone. Clearing the inherited
    sources makes a local restore use the same source as CI and as anyone building from a fork,
    whatever feeds the machine has configured (such as the private GitHub Packages feed other
    Enclave repositories use).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
